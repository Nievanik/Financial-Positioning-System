# Public configuration only. Never put secrets in VITE_ variables.
# Express API origin (no trailing slash; the client appends /api/v1). Must match the server PORT (team default 5000).
# If :5000 is taken locally, override both in your ignored server/.env and client/.env.local.
# Leave unset to run the UI on labeled mock data (or add ?mock=1 to the URL).
VITE_API_BASE_URL=http://localhost:5000
